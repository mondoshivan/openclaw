# syntax=docker/dockerfile:1.7
#
# Thin extension layer over the official openclaw registry image that installs
# the Docker CLI so agents.defaults.sandbox can manage sibling containers via
# the host socket mounted at /var/run/docker.sock.
#
# Only the CLI is installed — no Docker daemon.
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.override.yml build openclaw-gateway
#
# The base image can be overridden at build time:
#   docker build --build-arg BASE_IMAGE=ghcr.io/openclaw/openclaw:1.2.3 -f Dockerfile.gateway-sandbox .
ARG BASE_IMAGE=ghcr.io/openclaw/openclaw:latest
ARG OPENCLAW_DOCKER_GPG_FINGERPRINT="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"

FROM ${BASE_IMAGE}

ARG OPENCLAW_DOCKER_GPG_FINGERPRINT

# Install must run as root; the base image drops to USER node at the end.
USER root

RUN --mount=type=cache,id=sandbox-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=sandbox-apt-lists,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    # Verify Docker apt signing key fingerprint before trusting it as a root key.
    # Update OPENCLAW_DOCKER_GPG_FINGERPRINT when Docker rotates release keys.
    curl -fsSL https://download.docker.com/linux/debian/gpg -o /tmp/docker.gpg.asc && \
    expected_fingerprint="$(printf '%s' "$OPENCLAW_DOCKER_GPG_FINGERPRINT" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')" && \
    actual_fingerprint="$(gpg --batch --show-keys --with-colons /tmp/docker.gpg.asc | awk -F: '$1 == "fpr" { print toupper($10); exit }')" && \
    if [ -z "$actual_fingerprint" ] || [ "$actual_fingerprint" != "$expected_fingerprint" ]; then \
      echo "ERROR: Docker apt key fingerprint mismatch (expected $expected_fingerprint, got ${actual_fingerprint:-<empty>})" >&2; \
      exit 1; \
    fi && \
    gpg --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.gpg.asc && \
    rm -f /tmp/docker.gpg.asc && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable\n' \
      "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      docker-ce-cli docker-compose-plugin && \
    # Clean up to keep the layer lean
    rm -rf /var/lib/apt/lists/*

USER node
